# ==============================================================================
# BUILD+ ENTERPRISE PORTAL - ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure for your environment.
# NEVER commit your actual .env file with secrets into version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SECURITY & HOST CONFIGURATION
# ------------------------------------------------------------------------------
# Generate a secure 50+ character random string in production
SECRET_KEY=change-this-to-a-secure-random-50-character-secret-key-in-production

# Set DEBUG=False in production!
DEBUG=False

# Comma-separated list of host/domain names this site can serve
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost

# Trusted origins for CSRF protection (must include protocol)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Enforce HTTPS redirect in production (set to True when SSL is active)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PRIMARY: MySQL for cPanel / phpMyAdmin / VPS)
# ------------------------------------------------------------------------------
# Supported DB_ENGINE values: mysql | postgresql | sqlite
DB_ENGINE=mysql
DB_NAME=construction_db
DB_USER=construction_user
DB_PASSWORD=your_strong_mysql_password_here
DB_HOST=localhost
DB_PORT=3306

# SQLite fallback (used automatically if DB_ENGINE=sqlite or local development)
# SQLITE_DB_PATH=db.sqlite3

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY INTEGRATIONS
# ------------------------------------------------------------------------------
# Razorpay Credentials (Optional: if using Razorpay Gateway)
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Cashfree Credentials (Optional: if using Cashfree Gateway)
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=PRODUCTION

# Company UPI Virtual Payment Address (VPA) & Details
UPI_VPA=buildplus@upi
UPI_PAYEE_NAME=BUILD+ Infrastructure & Construction
UPI_MERCHANT_CODE=1234

# ------------------------------------------------------------------------------
# 4. AI ASSISTANT & GOOGLE GEMINI API
# ------------------------------------------------------------------------------
# Google Gemini API Key for AI Customer Assistant and CMS Blog Writer
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 5. OUTBOUND SMTP EMAIL DISPATCH
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@yourdomain.com
EMAIL_HOST_PASSWORD=your_smtp_app_password_here
DEFAULT_FROM_EMAIL=BUILD+ Notifications <notifications@yourdomain.com>
SERVER_EMAIL=BUILD+ System <system@yourdomain.com>

# ------------------------------------------------------------------------------
# 6. STATIC & MEDIA FILE SETTINGS (cPanel / Nginx paths)
# ------------------------------------------------------------------------------
STATIC_URL=/static/
MEDIA_URL=/media/
# STATIC_ROOT=/home/username/public_html/static
# MEDIA_ROOT=/home/username/public_html/media
