# ==============================================================================
# BUILD+ ENTERPRISE PORTAL — CPANEL PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env in your application root (/home/username/construction_portal/.env)
# ==============================================================================

# Core Django Security
SECRET_KEY=replace-with-a-random-50-character-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Production MySQL Database (From cPanel MySQL Database Wizard)
DB_ENGINE=mysql
DB_NAME=cpaneluser_buildplus
DB_USER=cpaneluser_dbuser
DB_PASSWORD=your_strong_cpanel_db_password
DB_HOST=localhost
DB_PORT=3306

# Google Gemini API Key
GEMINI_API_KEY=your_google_gemini_api_key_here

# Outbound Email SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@yourdomain.com
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=BUILD+ Notifications <notifications@yourdomain.com>

# Payment Gateways (Optional)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
UPI_VPA=buildplus@upi
